{
  "expo": {
    "name": "TangFast",
    "slug": "TangerangFast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-baru.png",
    "notification": {
      "icon": "./assets/images/notif-icon.png",
      "color": "#0c57fe",
      "vapidPublicKey": "BFPdeTAbPGE5VGFZpZFav7IEn-2M6sUP9PJf39QSqb3SPmDwaSFvs93gJSCECXsjVswzcA1R4_m6ONz0eYQ_mOw",
      "serviceWorkerPath": "expo-service-worker.js"
    },
    "scheme": "tangerangfast",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tangerangfast.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aplikasi membutuhkan akses lokasi untuk mencari layanan terdekat."
      }
    },
    "web": {
      "themeColor": "#0c57fe",
      "config": {
        "firebase": {
          "apiKey": "AIzaSyDlcY6gl30RNhKvTFUMYLB9W-booJLYVHs",
          "authDomain": "mitra-tangerangfast.firebaseapp.com",
          "projectId": "mitra-tangerangfast",
          "messagingSenderId": "206607018424",
          "appId": "1:206607018424:web:4f0ddad4a1a6fc3aa7074d",
          "measurementId": "G-QWL9KRJ77J"
        }
      }
    },
    "android": {
      "package": "com.tangerangfast.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0c57fe",
        "foregroundImage": "./assets/images/icon-baru.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-baru.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notif-icon.png",
          "color": "#0c57fe",
          "sounds": [
            "./assets/sounds/notification.mp3"
          ],
          "mode": "production"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan TangerangFast mengakses lokasi Anda."
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "14d5785f-9410-43b8-bf9c-d742463c62dd"
      }
    }
  }
}